---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout title="About">
  <section>
    <div class="container about-wrap">
      <div class="about-header">
        <span class="badge badge-blue"><span class="material-icons-round">info</span>About Us</span>
        <h1>What is Silent.Drop?</h1>
        <p>A community-first, privacy-respecting platform for street food hygiene accountability.</p>
      </div>

      <div class="about-grid">
        <div class="card about-card">
          <span class="material-icons-round about-icon">verified_user</span>
          <h3>Our Mission</h3>
          <p>We believe everyone deserves access to safe street food. Silent.Drop empowers citizens to report hygiene violations anonymously, helping authorities and the community take action without fear of retaliation.</p>
        </div>
        <div class="card about-card">
          <span class="material-icons-round about-icon">architecture</span>
          <h3>How It Works</h3>
          <p>Users submit complaints — optionally with photos and geo-coordinates. Reports are stored in Supabase, processed by Cloudflare Workers, and displayed in real time on a public wall for full community transparency.</p>
        </div>
        <div class="card about-card">
          <span class="material-icons-round about-icon">security</span>
          <h3>Privacy First</h3>
          <p>No accounts required. No cookies. No tracking. Your identity is never recorded. We are built on edge infrastructure that processes data ephemerally, minimizing any privacy surface area.</p>
        </div>
      </div>

      <div class="tech-stack card">
        <h2><span class="material-icons-round">code</span>Technology Stack</h2>
        <div class="tech-grid">
          <div class="tech-item">
            <span class="material-icons-round tech-icon">rocket_launch</span>
            <strong>Astro</strong>
            <p>Static site framework for blazing fast pages</p>
          </div>
          <div class="tech-item">
            <span class="material-icons-round tech-icon">cloud</span>
            <strong>Cloudflare Workers</strong>
            <p>Edge-first serverless compute & KV storage</p>
          </div>
          <div class="tech-item">
            <span class="material-icons-round tech-icon">storage</span>
            <strong>Supabase</strong>
            <p>Open-source PostgreSQL backend & auth</p>
          </div>
          <div class="tech-item">
            <span class="material-icons-round tech-icon">map</span>
            <strong>Leaflet.js</strong>
            <p>Open-source interactive mapping library</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-wrap { max-width: 960px; margin: auto; }
  .about-header { text-align: center; margin-bottom: 3rem; }
  .about-header h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 1rem 0 0.75rem; }
  .about-header p { color: var(--muted); max-width: 540px; margin: auto; }

  .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem; }
  .about-card { transition: all 0.2s; }
  .about-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .about-icon { font-size: 2rem !important; color: var(--primary); margin-bottom: 1rem; display: block; }
  .about-card h3 { margin-bottom: 0.75rem; }
  .about-card p { color: var(--muted); line-height: 1.7; font-size: 0.9rem; }

  .tech-stack h2 { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; }
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; }
  .tech-item {
    background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 1.25rem; transition: all 0.2s;
  }
  .tech-item:hover { border-color: var(--primary); }
  .tech-icon { font-size: 1.6rem !important; color: var(--primary); margin-bottom: 0.5rem; display: block; }
  .tech-item strong { display: block; font-size: 0.95rem; margin-bottom: 0.35rem; }
  .tech-item p { color: var(--muted); font-size: 0.82rem; line-height: 1.5; margin: 0; }
</style>