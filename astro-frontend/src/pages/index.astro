---
import MainLayout from "../layouts/MainLayout.astro";

import Hero from "../components/Hero.astro";
---
<MainLayout title="Anonymous Feedback Wall">
	<Hero />
	<section>
		<div class="container">
			<div class="section-heading">
				<h2>
					Why Use Silent.Drop?
				</h2>
				<p>
					Built for speed, simplicity,
					and anonymous communication.
				</p>
			</div>
			<div class="features-grid">
				<div class="card feature-card">
					<h3>Anonymous Sharing</h3>
					<p>
						Submit honest feedback without
						revealing your identity.
					</p>
				</div>

				<div class="card feature-card">
					<h3>Edge Powered</h3>
					<p>
						Cloudflare Workers and KV provide
						lightning-fast performance.
					</p>
				</div>

				<div class="card feature-card">
					<h3>Modern Stack</h3>
					<p>
						Built using Astro, Supabase,
						and Cloudflare infrastructure.
					</p>
				</div>

			</div>
		</div>
	</section>
</MainLayout>

<style>
	.section-heading {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-heading h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.section-heading p {
		color: var(--muted);
	}

	.features-grid {
		display: grid;
		grid-template-columns:
    repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	.feature-card {
		transition: 0.2s ease;
	}

	.feature-card:hover {
		transform: translateY(-5px);
	}

	.feature-card h3 {
		margin-bottom: 1rem;
	}

	.feature-card p {
		color: var(--muted);
	}

</style>