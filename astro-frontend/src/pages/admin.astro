---
import MainLayout from "../../layouts/MainLayout.astro";
---
<MainLayout title="Admin Dashboard">
  <section>
    <div class="container">
      <div class="dash-header">
        <div>
          <span class="badge badge-blue"><span class="material-icons-round">admin_panel_settings</span>Dashboard</span>
          <h1>Admin Overview</h1>
          <p>Monitor and manage hygiene complaints in real time.</p>
        </div>
        <button id="logoutBtn" class="secondary-btn">
          <span class="material-icons-round">logout</span>
          Logout
        </button>
      </div>

      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card card">
          <div class="stat-icon-wrap blue"><span class="material-icons-round">inbox</span></div>
          <div class="stat-body">
            <h2 id="totalCount">—</h2>
            <p>Total Complaints</p>
          </div>
        </div>
        <div class="stat-card card">
          <div class="stat-icon-wrap red"><span class="material-icons-round">warning</span></div>
          <div class="stat-body">
            <h2 id="criticalCount">—</h2>
            <p>Critical Issues</p>
          </div>
        </div>
        <div class="stat-card card">
          <div class="stat-icon-wrap green"><span class="material-icons-round">check_circle</span></div>
          <div class="stat-body">
            <h2 id="resolvedCount">—</h2>
            <p>Resolved Cases</p>
          </div>
        </div>
        <div class="stat-card card">
          <div class="stat-icon-wrap amber"><span class="material-icons-round">pending</span></div>
          <div class="stat-body">
            <h2 id="reviewCount">—</h2>
            <p>In Review</p>
          </div>
        </div>
      </div>

      <!-- Chart + Offenders -->
      <div class="two-col">
        <div class="card chart-card">
          <h2 class="card-title"><span class="material-icons-round">donut_large</span>Severity Distribution</h2>
          <div class="chart-wrap">
            <canvas id="severityChart"></canvas>
          </div>
        </div>
        <div class="card offenders-card">
          <h2 class="card-title"><span class="material-icons-round">store</span>Frequent Offenders</h2>
          <div id="offendersList" class="offenders-list">
            <div class="loading-text">Loading...</div>
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="card map-card">
        <h2 class="card-title"><span class="material-icons-round">map</span>Complaint Hotspot Map</h2>
        <div id="adminMap"></div>
      </div>

      <!-- Table -->
      <div class="card table-card">
        <div class="table-header">
          <h2 class="card-title"><span class="material-icons-round">table_chart</span>Complaint Management</h2>
          <div class="tabs" id="filterTabs">
            <button class="tab-btn active" data-filter="All">All</button>
            <button class="tab-btn" data-filter="In Review">In Review</button>
            <button class="tab-btn" data-filter="Under Investigation">Investigating</button>
            <button class="tab-btn" data-filter="Action Taken">Action Taken</button>
            <button class="tab-btn" data-filter="Dismissed">Dismissed</button>
            <button class="tab-btn" data-filter="Resolved">Resolved</button>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Vendor</th>
                <th>Severity</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="complaintsTable"></tbody>
          </table>
        </div>
      </div>

    </div>
  </section>
</MainLayout>

<script>
  import { supabase } from "../../utils/supabase";
  import Chart from "chart.js/auto";

  let complaints: any[] = [];
  let chartInstance: any = null;
  let mapInstance: any = null;
  let currentFilter = "All";

  document.getElementById("logoutBtn")!.addEventListener("click", async () => {
    await supabase.auth.signOut();
    window.location.href = "/login";
  });

  supabase.channel("complaints-realtime")
    .on("postgres_changes", { event: "*", schema: "public", table: "complaints" }, () => loadDashboard())
    .subscribe();

  async function loadDashboard() {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.location.href = "/login"; return; }

      const apiUrl = import.meta.env.VITE_API_URL ?? "https://worker-api.yatin-a-anchan.workers.dev";
      const res = await fetch(`${apiUrl}/api/messages`);
      if (!res.ok) throw new Error(`Server error: ${res.status}`);
      complaints = await res.json();

      renderStats(); renderTable(); renderChart(); renderOffenders(); renderMap();
    } catch (err) {
      document.getElementById("complaintsTable")!.innerHTML =
        `<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--high)">Failed to load data</td></tr>`;
    }
  }

  function renderStats() {
    document.getElementById("totalCount")!.textContent = String(complaints.length);
    document.getElementById("criticalCount")!.textContent = String(complaints.filter(c => c.severity === "Critical").length);
    document.getElementById("resolvedCount")!.textContent = String(complaints.filter(c => c.status === "Resolved").length);
    document.getElementById("reviewCount")!.textContent = String(complaints.filter(c => c.status === "In Review").length);
  }

  const statuses = ["In Review","Under Investigation","Action Taken","Dismissed","Resolved"];

  function renderTable() {
    const data = currentFilter === "All" ? complaints : complaints.filter(c => c.status === currentFilter);
    document.getElementById("complaintsTable")!.innerHTML = data.map(c => `
      <tr>
        <td>
          <div class="vendor-cell">
            ${c.image_url ? `<img src="${c.image_url}" class="img-thumb" data-lightbox data-src="${c.image_url}" alt="${c.vendor_name}" />` : '<span class="material-icons-round no-img">store</span>'}
            <span>${c.vendor_name}</span>
          </div>
        </td>
        <td><span class="severity ${c.severity}">${c.severity}</span></td>
        <td>
          <select class="status-select" onchange="window.updateStatus(${c.id}, this.value)">
            ${statuses.map(s => `<option value="${s}" ${c.status === s ? "selected" : ""}>${s}</option>`).join('')}
          </select>
        </td>
        <td class="date-cell">${new Date(c.created_at).toLocaleDateString('en-IN')}</td>
        <td>
          <a href="/admin/complaint?id=${c.id}" class="view-btn secondary-btn">
            <span class="material-icons-round">open_in_new</span>View
          </a>
        </td>
      </tr>`).join('');

    // Lightbox for table images
    document.querySelectorAll('.img-thumb[data-lightbox]').forEach((img: any) => {
      img.addEventListener('click', () => {
        const lb = document.getElementById('lightbox');
        const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
        if (lb && lbImg) { lbImg.src = img.src; lbImg.classList.remove('zoomed'); lb.classList.add('active'); document.body.style.overflow = 'hidden'; }
      });
    });
  }

  function renderChart() {
    const ctx = document.getElementById("severityChart") as HTMLCanvasElement;
    const counts = { Low: 0, Medium: 0, High: 0, Critical: 0 };
    complaints.forEach(c => { if (c.severity in counts) (counts as any)[c.severity]++; });
    if (chartInstance) chartInstance.destroy();
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    chartInstance = new Chart(ctx, {
      type: "doughnut",
      data: {
        labels: Object.keys(counts),
        datasets: [{
          data: Object.values(counts),
          backgroundColor: ["#22c55e","#f59e0b","#ef4444","#dc2626"],
          borderColor: isDark ? "#111827" : "#ffffff",
          borderWidth: 3,
        }]
      },
      options: {
        plugins: {
          legend: { position: 'bottom', labels: { color: isDark ? '#a8b8d8' : '#334155', padding: 16, font: { family: 'Inter', size: 13 } } }
        },
        cutout: '65%',
      }
    });
  }

  function renderMap() {
    if (mapInstance) { mapInstance.remove(); mapInstance = null; }
    const L = (window as any).L;
    mapInstance = L.map("adminMap").setView([20.5937, 78.9629], 5);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "© OpenStreetMap" }).addTo(mapInstance);

    complaints.forEach(c => {
      if (!c.latitude || !c.longitude) return;
      const colors: Record<string,string> = { Low:"#22c55e", Medium:"#f59e0b", High:"#ef4444", Critical:"#dc2626" };
      const col = colors[c.severity] || "#4f8ef7";
      L.circleMarker([c.latitude, c.longitude], { radius: 10, color: col, fillColor: col, fillOpacity: 0.75, weight: 2 })
        .addTo(mapInstance!)
        .bindPopup(`<div style="min-width:160px"><strong>${c.vendor_name}</strong><br/><small>${c.severity} · ${c.status}</small><br/><small>${c.description?.slice(0,80)}...</small></div>`);
    });
  }

  function renderOffenders() {
    const offenders: Record<string, number> = {};
    complaints.forEach(c => { offenders[c.vendor_name] = (offenders[c.vendor_name] || 0) + 1; });
    const sorted = Object.entries(offenders).sort((a,b) => b[1]-a[1]).slice(0,6);
    const max = sorted[0]?.[1] || 1;
    document.getElementById("offendersList")!.innerHTML = sorted.map(([name, count]) => `
      <div class="offender-item">
        <div class="offender-info">
          <span class="offender-name">${name}</span>
          <span class="offender-count">${count} report${count !== 1 ? 's' : ''}</span>
        </div>
        <div class="offender-bar-wrap">
          <div class="offender-bar" style="width:${(count/max*100).toFixed(0)}%"></div>
        </div>
      </div>`).join('');
  }

  // Filter tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = (btn as HTMLElement).dataset.filter!;
      renderTable();
    });
  });

  async function updateStatus(id: number, status: string) {
    const apiUrl = import.meta.env.VITE_API_URL ?? "https://worker-api.yatin-a-anchan.workers.dev";
    await fetch(`${apiUrl}/api/update-status`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, status }),
    });
    await loadDashboard();
  }

  (window as any).updateStatus = updateStatus;
  loadDashboard();
</script>

<style>
  .dash-header { display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2.5rem; }
  .dash-header h1 { font-size:2.5rem;margin:0.5rem 0 0.25rem; }
  .dash-header p { color:var(--muted); }

  .stats-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.25rem;margin-bottom:1.5rem; }
  .stat-card { display:flex;align-items:center;gap:1.25rem;padding:1.5rem; }
  .stat-icon-wrap { width:52px;height:52px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
  .stat-icon-wrap.blue { background:rgba(79,142,247,0.12); }
  .stat-icon-wrap.blue .material-icons-round { color:var(--primary); }
  .stat-icon-wrap.red { background:var(--high-bg); }
  .stat-icon-wrap.red .material-icons-round { color:var(--high); }
  .stat-icon-wrap.green { background:var(--low-bg); }
  .stat-icon-wrap.green .material-icons-round { color:var(--low); }
  .stat-icon-wrap.amber { background:var(--medium-bg); }
  .stat-icon-wrap.amber .material-icons-round { color:var(--medium); }
  .stat-icon-wrap .material-icons-round { font-size:1.5rem !important; }
  .stat-body h2 { font-size:2rem;line-height:1;margin-bottom:0.2rem; }
  .stat-body p { color:var(--muted);font-size:0.85rem;margin:0; }

  .two-col { display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem; }
  @media (max-width:768px) { .two-col { grid-template-columns:1fr; } }

  .card-title { display:flex;align-items:center;gap:0.5rem;font-size:1.05rem;margin-bottom:1.5rem; }
  .card-title .material-icons-round { color:var(--primary); }

  .chart-wrap { display:flex;align-items:center;justify-content:center; }
  #severityChart { max-width:260px;max-height:260px; }

  .offenders-list { display:flex;flex-direction:column;gap:1rem; }
  .offender-item { display:flex;flex-direction:column;gap:0.4rem; }
  .offender-info { display:flex;justify-content:space-between;align-items:center; }
  .offender-name { font-size:0.875rem;font-weight:600; }
  .offender-count { font-size:0.8rem;color:var(--muted); }
  .offender-bar-wrap { height:5px;background:var(--border2);border-radius:999px;overflow:hidden; }
  .offender-bar { height:100%;background:var(--primary);border-radius:999px;transition:width 0.5s ease; }

  .map-card { margin-bottom:1.5rem; }
  #adminMap { height:480px;width:100%;border-radius:var(--radius);margin-top:0.5rem; }

  .table-card { overflow-x:auto; }
  .table-header { display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem; }
  .tabs { display:flex;flex-wrap:wrap;gap:0.4rem; }
  .tab-btn { padding:0.4rem 0.9rem;border-radius:999px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-size:0.8rem;font-weight:500;cursor:pointer;transition:all 0.2s; }
  .tab-btn:hover { background:var(--card2); }
  .tab-btn.active { background:var(--primary);color:white;border-color:var(--primary); }

  .table-wrap { overflow-x:auto; }
  table { width:100%;border-collapse:collapse;min-width:600px; }
  th { padding:0.75rem 1rem;font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);border-bottom:1px solid var(--border);text-align:left;white-space:nowrap; }
  td { padding:0.875rem 1rem;border-bottom:1px solid var(--border);font-size:0.9rem;vertical-align:middle; }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:var(--glass2); }

  .vendor-cell { display:flex;align-items:center;gap:0.75rem; }
  .no-img { color:var(--muted);font-size:1.2rem !important; }
  .img-thumb { width:36px;height:36px;border-radius:8px;object-fit:cover;cursor:pointer;flex-shrink:0; }
  .img-thumb:hover { transform:scale(1.1); }
  .date-cell { color:var(--muted);font-size:0.82rem;white-space:nowrap; }

  .status-select { padding:0.4rem 2rem 0.4rem 0.7rem;border-radius:var(--radius-sm);font-size:0.82rem;min-width:150px; }
  .view-btn { padding:0.4rem 0.85rem;font-size:0.8rem;border-radius:var(--radius-sm); }
  .loading-text { color:var(--muted);font-size:0.9rem;padding:1rem 0; }
</style>