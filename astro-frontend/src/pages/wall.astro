---
import MainLayout from "../layouts/MainLayout.astro";
---
<MainLayout title="Complaint Wall">
  <section>
    <div class="container">
      <div class="wall-header">
        <span class="badge badge-blue">
          <span class="material-icons-round">feed</span>
          Community Reports
        </span>
        <h1>Public Complaint Wall</h1>
        <p>Community-reported street food hygiene complaints, in real time.</p>
      </div>

      <div class="wall-filters" id="wallFilters">
        <button class="filter-chip active" data-filter="All">All</button>
        <button class="filter-chip" data-filter="Low">Low</button>
        <button class="filter-chip" data-filter="Medium">Medium</button>
        <button class="filter-chip" data-filter="High">High</button>
        <button class="filter-chip" data-filter="Critical">Critical</button>
      </div>

      <div id="complaintsContainer" class="complaints-grid">
        <div class="loading-grid">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  let allComplaints: any[] = [];

  async function loadComplaints() {
    const container = document.getElementById("complaintsContainer")!;
    try {
      const res = await fetch("https://worker-api.yatin-a-anchan.workers.dev/api/messages");
      allComplaints = await res.json();
      renderComplaints('All');
    } catch {
      container.innerHTML = `<div class="empty-state">
        <span class="material-icons-round empty-icon">cloud_off</span>
        <h2>Failed to load complaints</h2>
        <p>Could not reach the server. Please try again.</p>
      </div>`;
    }
  }

  function renderComplaints(filter: string) {
    const container = document.getElementById("complaintsContainer")!;
    const filtered = filter === 'All' ? allComplaints : allComplaints.filter(c => c.severity === filter);

    if (!filtered.length) {
      container.innerHTML = `<div class="empty-state">
        <span class="material-icons-round empty-icon">inbox</span>
        <h2>No complaints found</h2>
        <p>No ${filter !== 'All' ? filter.toLowerCase() + ' severity' : ''} reports yet.</p>
      </div>`;
      return;
    }

    container.innerHTML = `<div class="complaints-grid-inner">${filtered.map(c => `
      <div class="complaint-card card" data-id="${c.id}">
        <div class="img-wrap">
          <img src="${c.image_url || 'https://placehold.co/600x340/1a2236/4f8ef7?text=No+Image'}"
               class="img-fixed" alt="${c.vendor_name}" data-lightbox data-src="${c.image_url || ''}"
               style="height:200px;border-radius:var(--radius-lg) var(--radius-lg) 0 0" />
        <br>
        </div>

        <div class="card-body">
          <div class="top-row">
            <div>
              <h1 style="margin-bottom: 0.5rem;">${c.vendor_name || "Unknown Vendor"}</h2>
              <p class="vendor-type" style="margin-top: 0.5rem;"><span class="material-icons-round">storefront</span>${c.vendor_type}</p>
            </div>
            <span class="severity ${c.severity}" style="margin-top: 0.5rem;">${c.severity}</span>
          </div>

          <div class="issue-tags" style="margin-top: 0.5rem; margin-bottom: 0.75rem;">
            ${(c.issue_types || []).map((i: string) => `<span class="issue-tag"><i>"${i}" </i></span>`).join('')}
          </div>

          <div class="card-meta">
            <span class="status-pill"><span class="material-icons-round">pending</span> ${c.status}</span>&nbsp;&nbsp;&nbsp;
            <span class="card-date"><span class="material-icons-round">schedule</span>${new Date(c.created_at).toLocaleDateString('en-IN')}</span>
          </div>
<br>
          <button class="expand-btn secondary-btn" style="width:wrap-content; height:40px;" onclick="toggleDetails(${c.id}, this)">
            <span class="material-icons-round">expand_more</span>
            View Details
          </button>

          <div class="details-panel" id="details-${c.id}" style="display:none; margin-top:2rem;">
            <p class="desc-text"><bs>Description:</b> ${c.description}</p>
            ${c.latitude && c.longitude ? `
            <div class="map-embed">
              <div id="map-${c.id}" style="height:220px;border-radius:var(--radius-sm);overflow:hidden;margin-top:1rem"></div>
            </div>` : `<p class="no-location"><span class="material-icons-round">location_off</span>No location data</p>`}
            <p class="timestamp"><span class="material-icons-round">history</span> Reported: ${new Date(c.created_at).toLocaleString('en-IN')}</p>
          </div>
        </div>
      </div>
      <br>
    `).join('')}</div>`;

    // Attach lightbox to images
    document.querySelectorAll('[data-lightbox]').forEach((img: any) => {
      img.addEventListener('click', () => {
        const src = img.src;
        if (!src.includes('placehold.co')) {
          const lb = document.getElementById('lightbox');
          const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
          if (lb && lbImg) { lbImg.src = src; lbImg.classList.remove('zoomed'); lb.classList.add('active'); document.body.style.overflow = 'hidden'; }
        }
      });
    });
  }

  (window as any).toggleDetails = (id: number, btn: HTMLButtonElement) => {
    const panel = document.getElementById(`details-${id}`)!;
    const open = panel.style.display !== 'none';

    if (!open) {
      panel.style.display = 'block';
      btn.innerHTML = '<span class="material-icons-round">expand_less</span>Hide Details';

      const complaint = allComplaints.find(c => c.id === id);
      if (complaint?.latitude && complaint?.longitude && !(window as any)[`map_${id}`]) {
        setTimeout(() => {
          const L = (window as any).L;
          const m = L.map(`map-${id}`).setView([complaint.latitude, complaint.longitude], 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(m);
          let color = '#22c55e';
          if (complaint.severity === 'Medium') color = '#f59e0b';
          if (complaint.severity === 'High') color = '#ef4444';
          if (complaint.severity === 'Critical') color = '#dc2626';
          L.circleMarker([complaint.latitude, complaint.longitude], { radius: 12, color, fillColor: color, fillOpacity: 0.8, weight: 2 })
            .addTo(m).bindPopup(`<strong>${complaint.vendor_name}</strong><br/>${complaint.severity}`).openPopup();
          (window as any)[`map_${id}`] = m;
        }, 50);
      }
    } else {
      panel.style.display = 'none';
      btn.innerHTML = '<span class="material-icons-round">expand_more</span>View Details';
    }
  };

  // Filters
  document.querySelectorAll('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      renderComplaints((chip as HTMLElement).dataset.filter!);
    });
  });

  loadComplaints();
</script>

<style>
  .wall-header { text-align: center; margin-bottom: 2.5rem; }
  .wall-header h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 1rem 0 0.5rem; }
  .wall-header p { color: var(--muted); }

  .wall-filters {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    justify-content: center; margin-bottom: 2.5rem;
  }
  .filter-chip {
    padding: 0.45rem 1.1rem; border-radius: 999px;
    border: 1px solid var(--border2); background: transparent;
    color: var(--text2); font-size: 0.875rem; font-weight: 500;
    cursor: pointer; transition: all 0.2s;
  }
  .filter-chip:hover { background: var(--card2); }
  .filter-chip.active { background: var(--primary); color: white; border-color: var(--primary); }

  .complaints-grid-inner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  .complaint-card {
  padding: 0;
  overflow: hidden;
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
  background: var(--card);
}
  .complaint-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--border2); }

  .img-wrap { position: relative; overflow: hidden; }
  .img-overlay {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0); transition: 0.2s; opacity: 0;
  }
  .img-overlay .material-icons-round { color: white; font-size: 2rem !important; }
  .img-wrap:hover .img-overlay { opacity: 1; background: rgba(0,0,0,0.35); }

  .card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
  .top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 0.5rem;
}

.top-row h2 {
  font-size: 1.05rem;
  margin: 0;
  line-height: 1.4;
}
  .vendor-type {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--muted);
  font-size: 0.85rem;
  margin-top: 0.25rem;
}

.issue-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0.5rem 0 0.75rem;
}
  .vendor-type .material-icons-round { font-size: 0.9rem !important; }

  
  .issue-tag {
    background: var(--glass2); border: 1px solid var(--border2);
    padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.78rem; color: var(--text2);
  }

  .card-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin: 0.25rem 0 0.75rem;
}
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.3rem;
    background: rgba(79,142,247,0.12); color: var(--primary);
    border: 1px solid rgba(79,142,247,0.2);
    padding: 0.25rem 0.65rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600;
  }
  .status-pill .material-icons-round { font-size: 0.8rem !important; }
  .card-date { display: flex; align-items: center; gap: 0.3rem; color: var(--muted); font-size: 0.8rem; }
  .card-date .material-icons-round { font-size: 0.85rem !important; }

  .expand-btn { width: 100%; justify-content: center; padding: 0.6rem; font-size: 0.875rem; }

  .details-panel { margin-top: 1.25rem; border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .desc-text { color: var(--text2); line-height: 1.75; font-size: 0.9rem; margin-bottom: 0.75rem; }
  .timestamp { display: flex; align-items: center; gap: 0.3rem; color: var(--muted); font-size: 0.8rem; margin-top: 0.75rem; }
  .timestamp .material-icons-round { font-size: 0.85rem !important; }
  .no-location { display: flex; align-items: center; gap: 0.5rem; color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem; }

  .loading-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.5rem; }
  .skeleton-card {
    height: 400px; border-radius: var(--radius-lg);
    background: linear-gradient(90deg, var(--card) 25%, var(--card2) 50%, var(--card) 75%);
    background-size: 600px 100%;
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer { 0%{background-position:-600px 0} 100%{background-position:600px 0} }

  .empty-state { text-align: center; padding: 5rem 0; }
  .empty-icon { font-size: 3rem !important; color: var(--muted); display: block; margin-bottom: 1rem; }
  .empty-state h2 { margin-bottom: 0.5rem; }
  .empty-state p { color: var(--muted); }
</style>