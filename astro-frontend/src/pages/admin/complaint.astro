---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Complaint Details">
    <section>
        <div class="container">
            <!-- Back nav -->
            <div class="back-nav">
                <a href="/admin" class="back-btn">
                    <span class="material-icons-round">arrow_back</span>
                    Back to Dashboard
                </a>
            </div>

            <!-- Toast notification -->
            <div id="toast" class="toast" aria-live="polite"></div>

            <!-- Loading skeleton -->
            <div id="skeletonLoader" class="skeleton-wrapper">
                <div class="skeleton sk-image"></div>
                <div class="skeleton-body">
                    <div class="skeleton sk-title"></div>
                    <div class="skeleton sk-sub"></div>
                    <div class="skeleton sk-tags"></div>
                    <div class="skeleton sk-grid">
                        <div class="skeleton sk-box"></div>
                        <div class="skeleton sk-box"></div>
                    </div>
                    <div class="skeleton sk-desc"></div>
                </div>
            </div>

            <!-- Actual complaint content -->
            <div id="complaintContainer" class="details-card card" style="display:none"></div>

            <!-- Delete confirmation modal -->
            <div id="deleteModal" class="modal-overlay" role="dialog" aria-modal="true" aria-label="Confirm Delete">
                <div class="modal-box">
                    <div class="modal-icon">
                        <span class="material-icons-round">delete_forever</span>
                    </div>
                    <h2>Delete Complaint?</h2>
                    <p>This action is permanent and cannot be undone. The complaint will be removed from the system.</p>
                    <div class="modal-actions">
                        <button class="secondary-btn" onclick="closeModal()">Cancel</button>
                        <button class="danger-btn" id="confirmDeleteBtn">
                            <span class="material-icons-round">delete</span>
                            Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<script>
    const API_BASE = "https://worker-api.yatin-a-anchan.workers.dev";
    const STATUSES = ["Pending", "Under Review", "Resolved", "Dismissed"];

    let currentComplaint: any = null;

    // ── Toast ────────────────────────────────────────────────────────────────
    function showToast(message: string, type: "success" | "error" | "info" = "info") {
        const toast = document.getElementById("toast")!;
        toast.className = `toast toast-${type} show`;
        toast.innerHTML = `
            <span class="material-icons-round toast-icon">${type === "success" ? "check_circle" : type === "error" ? "error" : "info"}</span>
            <span>${message}</span>
        `;
        setTimeout(() => toast.classList.remove("show"), 3500);
    }

    // ── Skeleton ─────────────────────────────────────────────────────────────
    function hideSkeleton() {
        const sk = document.getElementById("skeletonLoader")!;
        sk.style.opacity = "0";
        sk.style.transition = "opacity 0.3s";
        setTimeout(() => (sk.style.display = "none"), 300);
    }

    // ── Severity badge helper ─────────────────────────────────────────────────
    function severityIcon(s: string) {
        return s === "Critical" ? "emergency" : s === "High" ? "warning" : s === "Medium" ? "info" : "check_circle";
    }

    // ── Render complaint ──────────────────────────────────────────────────────
    function renderComplaint(complaint: any) {
        const container = document.getElementById("complaintContainer")!;

        const mapHtml =
            complaint.latitude && complaint.longitude
                ? `<div class="section-label"><span class="material-icons-round">location_on</span>Location</div>
                   <div class="map-wrapper">
                     <iframe
                       width="100%" height="360" frameborder="0" scrolling="no" loading="lazy"
                       src="https://www.openstreetmap.org/export/embed.html?bbox=${complaint.longitude - 0.01}%2C${complaint.latitude - 0.01}%2C${complaint.longitude + 0.01}%2C${complaint.latitude + 0.01}&layer=mapnik&marker=${complaint.latitude}%2C${complaint.longitude}"
                     ></iframe>
                   </div>`
                : `<div class="no-location"><span class="material-icons-round">location_off</span>No location data available</div>`;

        const issueTagsHtml = (complaint.issue_types ?? [])
            .map((i: string) => `<span class="issue-tag">${i}</span>`)
            .join("");

        const statusOptionsHtml = STATUSES.map(
            (s) => `<option value="${s}" ${complaint.status === s ? "selected" : ""}>${s}</option>`
        ).join("");

        container.innerHTML = `
            <div class="hero-image-wrap">
                <img
                    src="${complaint.image_url || "https://placehold.co/1200x500/1a2236/4f8ef7?text=No+Image"}"
                    class="detail-image"
                    alt="Evidence photo for ${complaint.vendor_name}"
                    onerror="this.src='https://placehold.co/1200x500/1a2236/4f8ef7?text=Image+Not+Found'"
                />
                <div class="hero-overlay">
                    <span class="severity-badge ${complaint.severity}">
                        <span class="material-icons-round">${severityIcon(complaint.severity)}</span>
                        ${complaint.severity}
                    </span>
                </div>
            </div>

            <div class="detail-content">
                <!-- Header row -->
                <div class="title-row">
                    <div>
                        <h1 class="vendor-title">${complaint.vendor_name}</h1>
                        <p class="vendor-type">
                            <span class="material-icons-round">storefront</span>
                            ${complaint.vendor_type}
                        </p>
                    </div>
                    <!-- Action buttons -->
                    <div class="action-buttons">
                        <button class="icon-btn danger-icon-btn" onclick="openDeleteModal()" title="Delete complaint">
                            <span class="material-icons-round">delete</span>
                        </button>
                    </div>
                </div>

                <!-- Issue tags -->
                ${issueTagsHtml ? `<div class="issues">${issueTagsHtml}</div>` : ""}

                <!-- Info grid -->
                <div class="info-grid">
                    <div class="info-box">
                        <div class="info-label"><span class="material-icons-round">pending</span> Status</div>
                        <div class="status-update-row">
                            <select id="statusSelect" class="status-select severity-${complaint.severity.toLowerCase()}" aria-label="Update status">
                                ${statusOptionsHtml}
                            </select>
                            <button class="update-btn" onclick="updateStatus()" title="Save status">
                                <span class="material-icons-round">save</span>
                                Update
                            </button>
                        </div>
                    </div>
                    <div class="info-box">
                        <div class="info-label"><span class="material-icons-round">schedule</span> Reported On</div>
                        <div class="info-value">${new Date(complaint.created_at).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}</div>
                    </div>
                    <div class="info-box">
                        <div class="info-label"><span class="material-icons-round">tag</span> Complaint ID</div>
                        <div class="info-value mono">#${complaint.id}</div>
                    </div>
                </div>

                <!-- Description -->
                <div class="description-box">
                    <div class="section-label"><span class="material-icons-round">description</span>Description</div>
                    <p class="desc-body">${complaint.description || "No description provided."}</p>
                </div>

                <!-- Map -->
                ${mapHtml}
            </div>
        `;

        hideSkeleton();
        container.style.display = "block";
        container.style.opacity = "0";
        container.style.transition = "opacity 0.4s ease";
        setTimeout(() => (container.style.opacity = "1"), 50);
    }

    // ── Load complaint ────────────────────────────────────────────────────────
    async function loadComplaint() {
        const container = document.getElementById("complaintContainer")!;
        const params = new URLSearchParams(window.location.search);
        const id = params.get("id");

        if (!id) {
            hideSkeleton();
            container.style.display = "block";
            container.innerHTML = `<div class="error-state">
                <span class="material-icons-round">error_outline</span>
                <h2>No complaint ID provided</h2>
                <p>Please go back and select a valid complaint.</p>
                <a href="/admin" class="secondary-btn">← Back to Dashboard</a>
            </div>`;
            return;
        }

        try {
            const res = await fetch(`${API_BASE}/api/messages`);
            if (!res.ok) throw new Error(`Server error: ${res.status}`);

            const complaints = await res.json();
            currentComplaint = complaints.find((c: any) => String(c.id) === String(id));

            if (!currentComplaint) {
                hideSkeleton();
                container.style.display = "block";
                container.innerHTML = `<div class="error-state">
                    <span class="material-icons-round">search_off</span>
                    <h2>Complaint not found</h2>
                    <p>No complaint with ID #${id} exists.</p>
                    <a href="/admin" class="secondary-btn">← Back to Dashboard</a>
                </div>`;
                return;
            }

            renderComplaint(currentComplaint);
        } catch (err) {
            console.error(err);
            hideSkeleton();
            container.style.display = "block";
            container.innerHTML = `<div class="error-state">
                <span class="material-icons-round">cloud_off</span>
                <h2>Failed to load complaint</h2>
                <p>Could not reach the server. Please try again later.</p>
                <a href="/admin" class="secondary-btn">← Back to Dashboard</a>
            </div>`;
        }
    }

    // ── Status update ─────────────────────────────────────────────────────────
    (window as any).updateStatus = async () => {
        if (!currentComplaint) return;
        const select = document.getElementById("statusSelect") as HTMLSelectElement;
        const newStatus = select.value;

        if (newStatus === currentComplaint.status) {
            showToast("Status is already set to " + newStatus, "info");
            return;
        }

        const btn = document.querySelector(".update-btn") as HTMLButtonElement;
        btn.disabled = true;
        btn.innerHTML = `<span class="material-icons-round spin">autorenew</span> Saving...`;

        try {
            const res = await fetch(`${API_BASE}/api/messages/${currentComplaint.id}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status: newStatus }),
            });

            if (!res.ok) throw new Error();
            currentComplaint.status = newStatus;
            showToast(`Status updated to "${newStatus}"`, "success");
        } catch {
            showToast("Failed to update status. Please try again.", "error");
            select.value = currentComplaint.status; // revert
        } finally {
            btn.disabled = false;
            btn.innerHTML = `<span class="material-icons-round">save</span> Update`;
        }
    };

    // ── Delete ────────────────────────────────────────────────────────────────
    (window as any).openDeleteModal = () => {
        document.getElementById("deleteModal")!.classList.add("active");
        document.body.style.overflow = "hidden";
    };

    (window as any).closeModal = () => {
        document.getElementById("deleteModal")!.classList.remove("active");
        document.body.style.overflow = "";
    };

    document.getElementById("confirmDeleteBtn")!.addEventListener("click", async () => {
        if (!currentComplaint) return;

        const btn = document.getElementById("confirmDeleteBtn") as HTMLButtonElement;
        btn.disabled = true;
        btn.innerHTML = `<span class="material-icons-round spin">autorenew</span> Deleting...`;

        try {
            const res = await fetch(`${API_BASE}/api/messages/${currentComplaint.id}`, {
                method: "DELETE",
            });

            if (!res.ok) throw new Error();
            (window as any).closeModal();
            showToast("Complaint deleted successfully. Redirecting...", "success");
            setTimeout(() => (window.location.href = "/admin"), 1800);
        } catch {
            (window as any).closeModal();
            showToast("Failed to delete complaint. Please try again.", "error");
            btn.disabled = false;
            btn.innerHTML = `<span class="material-icons-round">delete</span> Yes, Delete`;
        }
    });

    // Close modal on backdrop click
    document.getElementById("deleteModal")!.addEventListener("click", (e) => {
        if (e.target === e.currentTarget) (window as any).closeModal();
    });

    // Close modal on Escape key
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") (window as any).closeModal();
    });

    loadComplaint();
</script>

<style>
    /* ── Back nav ─────────────────────────────────────────────────────────── */
    .back-nav { margin-bottom: 1.5rem; }
    .back-btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        color: var(--muted); font-size: 0.9rem; text-decoration: none;
        transition: color 0.2s;
    }
    .back-btn:hover { color: var(--text); }
    .back-btn .material-icons-round { font-size: 1.1rem !important; }

    /* ── Skeleton ─────────────────────────────────────────────────────────── */
    .skeleton-wrapper { border-radius: var(--radius-lg); overflow: hidden; }
    .skeleton {
        background: linear-gradient(90deg, var(--card) 25%, var(--card2) 50%, var(--card) 75%);
        background-size: 600px 100%;
        animation: shimmer 1.5s infinite;
        border-radius: var(--radius-sm);
    }
    @keyframes shimmer { 0%{background-position:-600px 0} 100%{background-position:600px 0} }
    .sk-image { height: 420px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
    .skeleton-body { padding: 2rem; background: var(--card); display: flex; flex-direction: column; gap: 1rem; }
    .sk-title { height: 2.5rem; width: 60%; }
    .sk-sub { height: 1rem; width: 30%; }
    .sk-tags { height: 2rem; width: 50%; }
    .sk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .sk-box { height: 100px; }
    .sk-desc { height: 120px; }

    /* ── Card ─────────────────────────────────────────────────────────────── */
    .details-card { overflow: hidden; padding: 0; }

    /* ── Hero image ───────────────────────────────────────────────────────── */
    .hero-image-wrap { position: relative; }
    .detail-image {
        width: 100%; height: 420px; object-fit: cover; display: block;
    }
    .hero-overlay {
        position: absolute; bottom: 1.25rem; right: 1.25rem;
    }
    .severity-badge {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.45rem 1rem; border-radius: 999px;
        color: #fff; font-weight: 700; font-size: 0.875rem;
        letter-spacing: 0.03em; backdrop-filter: blur(8px);
        box-shadow: 0 2px 12px rgba(0,0,0,0.4);
    }
    .severity-badge .material-icons-round { font-size: 1rem !important; }
    .severity-badge.Low    { background: rgba(21,128,61,0.9); }
    .severity-badge.Medium { background: rgba(202,138,4,0.9); }
    .severity-badge.High   { background: rgba(220,38,38,0.9); }
    .severity-badge.Critical { background: rgba(127,29,29,0.95); }

    /* ── Detail content ───────────────────────────────────────────────────── */
    .detail-content { padding: 2rem 2.5rem; display: flex; flex-direction: column; gap: 1.75rem; }

    .title-row {
        display: flex; justify-content: space-between;
        align-items: flex-start; gap: 1rem;
    }
    .vendor-title { font-size: clamp(1.4rem, 3vw, 2rem); margin: 0 0 0.4rem; line-height: 1.2; }
    .vendor-type {
        display: flex; align-items: center; gap: 0.4rem;
        color: var(--muted); font-size: 0.9rem; margin: 0;
    }
    .vendor-type .material-icons-round { font-size: 1rem !important; }

    /* ── Action buttons ───────────────────────────────────────────────────── */
    .action-buttons { display: flex; gap: 0.5rem; flex-shrink: 0; }
    .icon-btn {
        width: 42px; height: 42px; border-radius: 10px; border: none;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: all 0.2s;
    }
    .danger-icon-btn {
        background: rgba(220,38,38,0.1); color: #ef4444;
        border: 1px solid rgba(220,38,38,0.2);
    }
    .danger-icon-btn:hover { background: rgba(220,38,38,0.2); transform: scale(1.05); }
    .danger-icon-btn .material-icons-round { font-size: 1.2rem !important; }

    /* ── Issue tags ───────────────────────────────────────────────────────── */
    .issues { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .issue-tag {
        background: var(--glass2, rgba(255,255,255,0.06));
        border: 1px solid var(--border2);
        padding: 0.35rem 0.9rem; border-radius: 999px;
        font-size: 0.8rem; color: var(--text2);
    }

    /* ── Info grid ────────────────────────────────────────────────────────── */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }
    .info-box {
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border);
        padding: 1.25rem 1.5rem;
        border-radius: var(--radius-md, 16px);
        display: flex; flex-direction: column; gap: 0.6rem;
    }
    .info-label {
        display: flex; align-items: center; gap: 0.4rem;
        color: var(--muted); font-size: 0.78rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
    }
    .info-label .material-icons-round { font-size: 0.9rem !important; }
    .info-value { font-size: 0.95rem; font-weight: 500; color: var(--text); }
    .mono { font-family: monospace; font-size: 1rem; }

    /* ── Status update ────────────────────────────────────────────────────── */
    .status-update-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .status-select {
        flex: 1; min-width: 120px;
        background: var(--card2, rgba(255,255,255,0.08));
        border: 1px solid var(--border2);
        color: var(--text);
        padding: 0.45rem 0.75rem;
        border-radius: 8px; font-size: 0.875rem; cursor: pointer;
        outline: none; transition: border-color 0.2s;
    }
    .status-select:focus { border-color: var(--primary); }
    .update-btn {
        display: inline-flex; align-items: center; gap: 0.35rem;
        background: var(--primary); color: #fff;
        border: none; padding: 0.45rem 1rem;
        border-radius: 8px; font-size: 0.85rem; font-weight: 600;
        cursor: pointer; transition: all 0.2s; white-space: nowrap;
    }
    .update-btn:hover { filter: brightness(1.15); }
    .update-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .update-btn .material-icons-round { font-size: 1rem !important; }

    /* ── Section label ────────────────────────────────────────────────────── */
    .section-label {
        display: flex; align-items: center; gap: 0.5rem;
        font-size: 0.78rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.75rem;
    }
    .section-label .material-icons-round { font-size: 0.95rem !important; }

    /* ── Description ──────────────────────────────────────────────────────── */
    .description-box { }
    .desc-body {
        color: var(--text2); line-height: 1.85; font-size: 0.95rem;
        background: rgba(255,255,255,0.03); border: 1px solid var(--border);
        padding: 1.25rem 1.5rem; border-radius: var(--radius-md, 14px);
        margin: 0;
    }

    /* ── Map ──────────────────────────────────────────────────────────────── */
    .map-wrapper {
        border-radius: var(--radius-md, 16px);
        overflow: hidden;
        border: 1px solid var(--border);
    }
    .no-location {
        display: flex; align-items: center; gap: 0.5rem;
        color: var(--muted); font-size: 0.875rem;
        padding: 1rem; background: rgba(255,255,255,0.03);
        border: 1px dashed var(--border); border-radius: var(--radius-md, 14px);
    }

    /* ── Error / empty state ──────────────────────────────────────────────── */
    .error-state {
        text-align: center; padding: 5rem 2rem;
        display: flex; flex-direction: column; align-items: center; gap: 1rem;
    }
    .error-state .material-icons-round { font-size: 3rem !important; color: var(--muted); }
    .error-state h2 { margin: 0; }
    .error-state p { color: var(--muted); margin: 0; }

    /* ── Toast ────────────────────────────────────────────────────────────── */
    .toast {
        position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(30px);
        display: flex; align-items: center; gap: 0.6rem;
        padding: 0.75rem 1.5rem; border-radius: 999px;
        font-size: 0.875rem; font-weight: 500;
        background: var(--card); border: 1px solid var(--border2);
        color: var(--text); box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        opacity: 0; transition: all 0.35s cubic-bezier(0.34,1.56,0.64,1);
        z-index: 9999; pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast-success { background: rgba(21,128,61,0.95); border-color: #15803d; color: #fff; }
    .toast-error   { background: rgba(220,38,38,0.95); border-color: #dc2626; color: #fff; }
    .toast-info    { background: var(--card); }
    .toast-icon { font-size: 1.1rem !important; }

    /* ── Delete modal ─────────────────────────────────────────────────────── */
    .modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center;
        z-index: 9000; opacity: 0; pointer-events: none;
        transition: opacity 0.25s;
    }
    .modal-overlay.active { opacity: 1; pointer-events: all; }
    .modal-box {
        background: var(--card); border: 1px solid var(--border2);
        border-radius: var(--radius-lg, 20px); padding: 2.5rem 2rem;
        max-width: 420px; width: 90%; text-align: center;
        transform: scale(0.92); transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
        box-shadow: 0 24px 64px rgba(0,0,0,0.5);
    }
    .modal-overlay.active .modal-box { transform: scale(1); }
    .modal-icon {
        width: 64px; height: 64px; border-radius: 50%;
        background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.2);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.25rem;
    }
    .modal-icon .material-icons-round { font-size: 2rem !important; color: #ef4444; }
    .modal-box h2 { margin: 0 0 0.75rem; font-size: 1.25rem; }
    .modal-box p { color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 2rem; }
    .modal-actions { display: flex; gap: 0.75rem; justify-content: center; }

    .danger-btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: #dc2626; color: #fff; border: none;
        padding: 0.6rem 1.5rem; border-radius: 10px;
        font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    .danger-btn:hover { background: #b91c1c; }
    .danger-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .danger-btn .material-icons-round { font-size: 1rem !important; }

    /* ── Spinner ──────────────────────────────────────────────────────────── */
    .spin { animation: spin 0.8s linear infinite; display: inline-block; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── Responsive ───────────────────────────────────────────────────────── */
    @media (max-width: 640px) {
        .detail-content { padding: 1.5rem; }
        .detail-image { height: 260px; }
        .info-grid { grid-template-columns: 1fr; }
        .modal-actions { flex-direction: column; }
    }
</style>