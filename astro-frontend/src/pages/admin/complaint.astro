---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Complaint Details">
    <section>
        <div class="container">

            <!-- Back nav -->
            <div class="back-nav">
                <a href="/admin" class="back-btn">
                    <span class="material-icons-round">arrow_back</span>
                    Back to Dashboard
                </a>
            </div>

            <!-- Toast notification -->
            <div id="toast" class="toast" aria-live="polite"></div>

            <!-- Loading skeleton -->
            <div id="skeletonLoader" class="skeleton-wrapper">
                <div class="skeleton sk-image"></div>
                <div class="skeleton-body">
                    <div class="skeleton sk-title"></div>
                    <div class="skeleton sk-sub"></div>
                    <div class="skeleton sk-tags"></div>
                    <div class="skeleton sk-grid">
                        <div class="skeleton sk-box"></div>
                        <div class="skeleton sk-box"></div>
                        <div class="skeleton sk-box"></div>
                    </div>
                    <div class="skeleton sk-desc"></div>
                </div>
            </div>

            <!-- Actual complaint content -->
            <div id="complaintContainer" class="details-card" style="display:none"></div>

            <!-- Delete confirmation modal -->
            <div id="deleteModal" class="modal-overlay" role="dialog" aria-modal="true" aria-label="Confirm Delete">
                <div class="modal-box">
                    <div class="modal-icon">
                        <span class="material-icons-round">delete_forever</span>
                    </div>
                    <h2>Delete this complaint?</h2>
                    <p>This is permanent and cannot be undone. The complaint will be removed from the system entirely.</p>
                    <div class="modal-actions">
                        <button class="cancel-btn" onclick="closeModal()">Cancel</button>
                        <button class="danger-btn" id="confirmDeleteBtn">
                            <span class="material-icons-round">delete</span>
                            Yes, Delete
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </section>
</MainLayout>

<script>
    const API_BASE = "https://worker-api.yatin-a-anchan.workers.dev";
    const STATUSES = ["Pending", "Under Review", "Resolved", "Dismissed"];

    let currentComplaint: any = null;

    // ── Toast ────────────────────────────────────────────────────────────────
    function showToast(message: string, type: "success" | "error" | "info" = "info") {
        const toast = document.getElementById("toast")!;
        toast.className = `toast toast-${type} show`;
        toast.innerHTML = `
            <span class="material-icons-round toast-icon">${type === "success" ? "check_circle" : type === "error" ? "error" : "info"}</span>
            <span>${message}</span>
        `;
        setTimeout(() => toast.classList.remove("show"), 3500);
    }

    // ── Skeleton ─────────────────────────────────────────────────────────────
    function hideSkeleton() {
        const sk = document.getElementById("skeletonLoader")!;
        sk.style.opacity = "0";
        sk.style.transition = "opacity 0.3s";
        setTimeout(() => (sk.style.display = "none"), 300);
    }

    // ── Severity icon helper ──────────────────────────────────────────────────
    function severityIcon(s: string) {
        return s === "Critical" ? "emergency" : s === "High" ? "warning" : s === "Medium" ? "info" : "check_circle";
    }

    // ── Render complaint ──────────────────────────────────────────────────────
    function renderComplaint(complaint: any) {
        const container = document.getElementById("complaintContainer")!;

        const mapHtml =
            complaint.latitude && complaint.longitude
                ? `<br/><div class="section-head" style="display:flex; align-items:center; gap:8px; margin-bottom:0.5rem;">
                       <span class="material-icons-round">location_on</span>
                       <span>Location</span>
                   </div>
                   <div class="map-frame">
                     <iframe
                       width="95%" height="320" frameborder="0" scrolling="no" loading="lazy"
                       src="https://www.openstreetmap.org/export/embed.html?bbox=${complaint.longitude - 0.01}%2C${complaint.latitude - 0.01}%2C${complaint.longitude + 0.01}%2C${complaint.latitude + 0.01}&layer=mapnik&marker=${complaint.latitude}%2C${complaint.longitude}"
                     ></iframe>
                   </div>`
                : `<div class="no-location"><span class="material-icons-round">location_off</span>No location data available</div>`;

        const issueTagsHtml = (complaint.issue_types ?? [])
            .map((i: string) => `<span class="tag">${i}</span>`)
            .join("");

        const statusOptionsHtml = STATUSES.map(
            (s) => `<option value="${s}" ${complaint.status === s ? "selected" : ""}>${s}</option>`
        ).join("");

        container.innerHTML = `
            <!-- Hero image -->
            <div class="hero">
                <img
                    src="${complaint.image_url || "https://placehold.co/1200x500/111218/5b7fff?text=No+Image"}"
                    class="hero-img"
                    width="1200" height="500"
                    alt="Evidence photo for ${complaint.vendor_name}"
                    onerror="this.src='https://placehold.co/1200x500/111218/5b7fff?text=Image+Not+Found'"
                />
                <div class="hero-gradient"></div>
                <div class="hero-bottom">
                    <div class="hero-text">
                        <br>
                        <h1 class="hero-title" style="margin-bottom: 0.5rem;">${complaint.vendor_name}</h1>
                        <p class="hero-sub" style="margin-top: 0.5rem;">
                            <span class="material-icons-round">storefront</span>
                            ${complaint.vendor_type}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <span class="severity ${complaint.severity}" style="margin-top: 0.5rem;">${complaint.severity}</span>
                        <span class="material-icons-round">${severityIcon(complaint.severity)}</span>
                        ${complaint.severity}
                    </span>
                        </p>
                    </div>
                    
                </div>
            </div>

            <!-- Body -->
            <div class="body">

                <!-- Issue tags -->
                <div class="issue-tags" style="margin-top: 0.5rem; margin-bottom: 0.75rem;">
            ${((complaint.issue_types as string[]) || []).map((i: string) => `<span class="issue-tag"><i>"${i}" </i></span>`).join('')}
          </div>

                <div class="divider"></div>

                <!-- Meta grid -->
                <div class="meta-grid" style="margin-bottom:1.5rem;">
                    <div class="meta-card status-card" style="margin-bottom:1.5rem;">
                        <div class="meta-label" style="display:flex; align-items:center; gap:8px; margin-bottom:0.5rem;"><span class="material-icons-round">pending</span> Status</div>
                        <div class="status-row" style="display:flex; width:95%; align-items:center; gap:8px;"margin-bottom:0.5rem;">
                            <select id="statusSelect" class="status-select" aria-label="Update status">
                                ${statusOptionsHtml}
                            </select>
                            <button class="update-btn" onclick="updateStatus()" style="margin-bottom:0.5rem; background:none; align-items:center; gap:8px;" title="Save status">
                                <span class="material-icons-round">save</span>
                                Save
                            </button>
                        </div>
                    </div>
                    <div class="meta-card" style="display:flex; flex-direction:column; gap:4px; margin-bottom:0.5rem; margin-top:0.5rem;">
                        <div class="meta-label"><span class="material-icons-round">schedule</span> <b> Reported On -</b> ${new Date(complaint.created_at).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })}</div>
                    </div>
                    <div class="meta-card">
                       <div class="meta-label">
  <span class="material-icons-round">tag</span>
  <b>Complaint ID - </b>
  <span 
    class="meta-val mono"
    style="
      margin-left: 0.5rem;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      border: 1px solid white;
      display: inline-block; width: 80px;
    "
  >
    #${complaint.id}
  </span>
</div><hr style="margin: 1rem 0;" width="96%" align="center"/>
                </div>

                <!-- Description -->
                <div>
                    <div class="section-head"style="display:flex; align-items:center; gap:8px; margin-bottom:0.5rem;">
                        <span class="material-icons-round">description</span>
                        <b>Description</b>
                    </div><i>
                    <div class="desc-box">${complaint.description || "No description provided."}</div></i>
                </div>

                <!-- Map -->
                ${mapHtml}

                <!-- Delete -->
                <div class="actions-strip" style="margin-top: 2rem; display:flex; width: 88px; height: 42px; border: 2px solid red; align-items:center;" >
                    <button class="del-btn" onclick="openDeleteModal()" style="background:red; align-items:center; gap:8px; width: 88px; height: 40px; padding: 0.5rem; border: 3px solid #ccc;" title="Delete Complaint">
                        <span class="material-icons-round">delete</span>
                        Delete
                    </button>
                </div>

            </div>
        `;

        hideSkeleton();
        container.style.display = "block";
        container.style.opacity = "0";
        container.style.transition = "opacity 0.4s ease";
        setTimeout(() => (container.style.opacity = "1"), 50);
    }

    // ── Load complaint ────────────────────────────────────────────────────────
    async function loadComplaint() {
        const container = document.getElementById("complaintContainer")!;
        const params = new URLSearchParams(window.location.search);
        const id = params.get("id");

        if (!id) {
            hideSkeleton();
            container.style.display = "block";
            container.innerHTML = `<div class="error-state">
                <span class="material-icons-round">error_outline</span>
                <h2>No complaint ID provided</h2>
                <p>Please go back and select a valid complaint.</p>
                <a href="/admin" class="cancel-btn">← Back to Dashboard</a>
            </div>`;
            return;
        }

        try {
            const res = await fetch(`${API_BASE}/api/messages`);
            if (!res.ok) throw new Error(`Server error: ${res.status}`);

            const complaints = await res.json();
            currentComplaint = complaints.find((c: any) => String(c.id) === String(id));

            if (!currentComplaint) {
                hideSkeleton();
                container.style.display = "block";
                container.innerHTML = `<div class="error-state">
                    <span class="material-icons-round">search_off</span>
                    <h2>Complaint not found</h2>
                    <p>No complaint with ID #${id} exists.</p>
                    <a href="/admin" class="cancel-btn">← Back to Dashboard</a>
                </div>`;
                return;
            }

            renderComplaint(currentComplaint);
        } catch (err) {
            console.error(err);
            hideSkeleton();
            container.style.display = "block";
            container.innerHTML = `<div class="error-state">
                <span class="material-icons-round">cloud_off</span>
                <h2>Failed to load complaint</h2>
                <p>Could not reach the server. Please try again later.</p>
                <a href="/admin" class="cancel-btn">← Back to Dashboard</a>
            </div>`;
        }
    }

    // ── Status update ─────────────────────────────────────────────────────────
    (window as any).updateStatus = async () => {
        if (!currentComplaint) return;
        const select = document.getElementById("statusSelect") as HTMLSelectElement;
        const newStatus = select.value;

        if (newStatus === currentComplaint.status) {
            showToast("Status is already set to " + newStatus, "info");
            return;
        }

        const btn = document.querySelector(".update-btn") as HTMLButtonElement;
        btn.disabled = true;
        btn.innerHTML = `<span class="material-icons-round spin">autorenew</span> Saving…`;

        try {
            const res = await fetch(`${API_BASE}/api/messages/${currentComplaint.id}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status: newStatus }),
            });

            if (!res.ok) throw new Error();
            currentComplaint.status = newStatus;
            showToast(`Status updated to "${newStatus}"`, "success");
        } catch {
            showToast("Failed to update status. Please try again.", "error");
            select.value = currentComplaint.status;
        } finally {
            btn.disabled = false;
            btn.innerHTML = `<span class="material-icons-round">save</span> Save`;
        }
    };

    // ── Delete ────────────────────────────────────────────────────────────────
    (window as any).openDeleteModal = () => {
        document.getElementById("deleteModal")!.classList.add("active");
        document.body.style.overflow = "hidden";
    };

    (window as any).closeModal = () => {
        document.getElementById("deleteModal")!.classList.remove("active");
        document.body.style.overflow = "";
    };

    document.getElementById("confirmDeleteBtn")!.addEventListener("click", async () => {
        if (!currentComplaint) return;

        const btn = document.getElementById("confirmDeleteBtn") as HTMLButtonElement;
        btn.disabled = true;
        btn.innerHTML = `<span class="material-icons-round spin">autorenew</span> Deleting…`;

        try {
            const res = await fetch(`${API_BASE}/api/messages/${currentComplaint.id}`, {
                method: "DELETE",
            });

            if (!res.ok) throw new Error();
            (window as any).closeModal();
            showToast("Complaint deleted successfully. Redirecting…", "success");
            setTimeout(() => (window.location.href = "/admin"), 1800);
        } catch {
            (window as any).closeModal();
            showToast("Failed to delete complaint. Please try again.", "error");
            btn.disabled = false;
            btn.innerHTML = `<span class="material-icons-round">delete</span> Yes, Delete`;
        }
    });

    document.getElementById("deleteModal")!.addEventListener("click", (e) => {
        if (e.target === e.currentTarget) (window as any).closeModal();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") (window as any).closeModal();
    });

    loadComplaint();
</script>

<style>
    /* ── Google Fonts ─────────────────────────────────────────────────────── */
    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap');

    /* ── Local design tokens ──────────────────────────────────────────────── */
    :root {
        --font-display: 'Syne', sans-serif;
        --font-body:    'DM Sans', sans-serif;
        --surface:      #111218;
        --surface2:     #181a22;
        --border:       rgba(255,255,255,0.07);
        --border2:      rgba(255,255,255,0.13);
        --txt:          #f0f0f5;
        --muted:        #7a7d8e;
        --accent:       #5b7fff;
    }

    /* ── Back nav ─────────────────────────────────────────────────────────── */
    .back-nav { margin-bottom: 2rem; }
    .back-btn {
        display: inline-flex; align-items: center; gap: 6px;
        color: var(--muted); font-size: 13px; text-decoration: none;
        letter-spacing: 0.04em; transition: color 0.2s;
        font-family: var(--font-body);
    }
    .back-btn:hover { color: var(--txt); }
    .back-btn .material-icons-round { font-size: 16px !important; }

    /* ── Skeleton ─────────────────────────────────────────────────────────── */
    .skeleton-wrapper { border-radius: 20px; overflow: hidden; }
    .skeleton {
        background: linear-gradient(90deg, var(--surface) 25%, var(--surface2) 50%, var(--surface) 75%);
        background-size: 600px 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 10px;
    }
    @keyframes shimmer { 0% { background-position: -600px 0 } 100% { background-position: 600px 0 } }
    .sk-image  { height: 380px; border-radius: 20px 20px 0 0; }
    .skeleton-body { padding: 2rem; background: var(--surface); display: flex; flex-direction: column; gap: 1rem; }
    .sk-title  { height: 2.2rem; width: 55%; }
    .sk-sub    { height: 1rem;   width: 28%; }
    .sk-tags   { height: 1.8rem; width: 45%; }
    .sk-grid   { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
    .sk-box    { height: 90px; }
    .sk-desc   { height: 110px; }

    /* ── Details card wrapper ─────────────────────────────────────────────── */
    .details-card { border-radius: 20px; overflow: hidden; }

    /* ── Hero ─────────────────────────────────────────────────────────────── */
    .hero { position: relative; height: 380px; }
    .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.65); }
    .hero-gradient {
        position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 30%, rgba(10,11,15,0.96) 100%);
    }
    .hero-bottom {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 2rem 2.5rem;
        display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem;
    }
    .hero-title {
        font-family: var(--font-display);
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 800; letter-spacing: -0.02em;
        line-height: 1.1; margin: 0 0 0.4rem;
        color: #fff;
    }
    .hero-sub {
        display: flex; align-items: center; gap: 5px;
        color: rgba(255,255,255,0.5); font-size: 13px;
        font-family: var(--font-body); margin: 0;
    }
    .hero-sub .material-icons-round { font-size: 15px !important; }

    /* ── Severity pill ────────────────────────────────────────────────────── */
    .severity {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px; border-radius: 99px;
        font-size: 12px; font-weight: 600; letter-spacing: 0.06em;
        text-transform: uppercase; flex-shrink: 0;
        font-family: var(--font-body);
    }
    .severity .material-icons-round { font-size: 14px !important; }
    .severity.Low      { background: rgba(20,83,45,0.9);  color: #86efac; border: 1px solid #166534; }
    .severity.Medium   { background: rgba(120,53,15,0.9); color: #fcd34d; border: 1px solid #92400e; }
    .severity.High     { background: rgba(124,45,18,0.9); color: #fdba74; border: 1px solid #9a3412; }
    .severity.Critical { background: rgba(127,29,29,0.9); color: #fca5a5; border: 1px solid #991b1b; }

    /* ── Body ─────────────────────────────────────────────────────────────── */
    .body {
        background: var(--surface);
        border: 1px solid var(--border);
        border-top: none;
        border-radius: 0 0 20px 20px;
        padding: 2rem 2.5rem;
        display: flex; flex-direction: column; gap: 1.75rem;
        font-family: var(--font-body);
    }

    /* ── Tags ─────────────────────────────────────────────────────────────── */
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
        padding: 5px 14px; border-radius: 6px;
        font-size: 12px; letter-spacing: 0.04em;
        background: rgba(91,127,255,0.1);
        color: #93aeff;
        border: 1px solid rgba(91,127,255,0.2);
    }

    /* ── Divider ──────────────────────────────────────────────────────────── */
    .divider { height: 1px; background: var(--border); }

    /* ── Meta grid ────────────────────────────────────────────────────────── */
    .meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
    }
    .meta-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
    }
    .meta-label {
        display: flex; align-items: center; gap: 5px;
        font-size: 11px; text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted);
        margin-bottom: 10px;
    }
    .meta-label .material-icons-round { font-size: 13px !important; }
    .meta-val {
        font-size: 15px; font-weight: 500; color: var(--txt);
        line-height: 1.4;
    }
    .meta-val.mono {
        font-family: monospace; font-size: 16px;
        color: var(--accent);
    }

    /* ── Status controls ──────────────────────────────────────────────────── */
    .status-row { display: flex; gap: 8px; align-items: center; }
    .status-select {
        flex: 1;
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border2);
        color: var(--txt);
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 14px;
        font-family: var(--font-body);
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s;
    }
    .status-select:focus { border-color: var(--accent); }
    .update-btn {
        display: inline-flex; align-items: center; gap: 5px;
        background: var(--accent); color: #fff; border: none;
        padding: 8px 16px; border-radius: 8px;
        font-size: 13px; font-weight: 600;
        font-family: var(--font-body);
        cursor: pointer; transition: opacity 0.2s; white-space: nowrap;
    }
    .update-btn:hover { opacity: 0.85; }
    .update-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .update-btn .material-icons-round { font-size: 15px !important; }

    /* ── Section head ─────────────────────────────────────────────────────── */
    .section-head {
        display: flex; align-items: center; gap: 6px;
        font-size: 11px; text-transform: uppercase;
        letter-spacing: 0.08em; color: var(--muted);
        margin-bottom: 12px;
    }
    .section-head .material-icons-round { font-size: 14px !important; }

    /* ── Description ──────────────────────────────────────────────────────── */
    .desc-box {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.5rem;
        line-height: 1.85;
        font-size: 14px;
        font-weight: 300;
        color: rgba(240,240,245,0.72);
        margin: 0;
    }

    /* ── Map ──────────────────────────────────────────────────────────────── */
    .map-frame {
        border-radius: 14px; overflow: hidden;
        border: 1px solid var(--border);
    }
    .map-frame iframe { display: block; }
    .no-location {
        display: flex; align-items: center; gap: 8px;
        color: var(--muted); font-size: 14px;
        padding: 1.25rem; border-radius: 14px;
        background: var(--surface2);
        border: 1px dashed var(--border2);
    }
    .no-location .material-icons-round { font-size: 18px !important; }

    /* ── Delete strip ─────────────────────────────────────────────────────── */
    .actions-strip { display: flex; justify-content: flex-end; }
    .del-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(220,38,38,0.08);
        color: #f87171;
        border: 1px solid rgba(220,38,38,0.18);
        padding: 9px 18px; border-radius: 10px;
        font-size: 13px; font-weight: 500;
        font-family: var(--font-body);
        cursor: pointer; transition: background 0.2s;
    }
    .del-btn:hover { background: rgba(220,38,38,0.15); }
    .del-btn .material-icons-round { font-size: 16px !important; }

    /* ── Error state ──────────────────────────────────────────────────────── */
    .error-state {
        text-align: center; padding: 5rem 2rem;
        display: flex; flex-direction: column; align-items: center; gap: 1rem;
        font-family: var(--font-body);
    }
    .error-state .material-icons-round { font-size: 3rem !important; color: var(--muted); }
    .error-state h2 { font-family: var(--font-display); margin: 0; }
    .error-state p  { color: var(--muted); margin: 0; font-size: 14px; }

    /* ── Toast ────────────────────────────────────────────────────────────── */
    .toast {
        position: fixed; bottom: 1.75rem; left: 50%;
        transform: translateX(-50%) translateY(40px);
        display: flex; align-items: center; gap: 8px;
        padding: 10px 20px; border-radius: 99px;
        font-size: 13px; font-weight: 500;
        font-family: var(--font-body);
        background: #1c1e2a;
        border: 1px solid var(--border2);
        color: var(--txt);
        box-shadow: 0 8px 32px rgba(0,0,0,0.5);
        opacity: 0; transition: all 0.35s cubic-bezier(0.34,1.56,0.64,1);
        z-index: 9999; pointer-events: none; white-space: nowrap;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast-success { background: rgba(20,83,45,0.97); border-color: #166534; color: #86efac; }
    .toast-error   { background: rgba(127,29,29,0.97); border-color: #991b1b; color: #fca5a5; }
    .toast-icon    { font-size: 16px !important; }

    /* ── Delete modal ─────────────────────────────────────────────────────── */
    .modal-overlay {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.75);
