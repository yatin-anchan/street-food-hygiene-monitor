---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Report Issue">
  <section>
    <div class="container">
      <div class="submit-wrap">
        <div class="submit-header">
          <div class="submit-icon">
            <span class="material-icons-round">report_problem</span>
          </div>
          <div>
            <h1>Report a Hygiene Issue</h1>
            <p class="subtitle">Help improve food safety in your area. Reports are anonymous.</p>
          </div>
        </div>

        <form id="feedbackForm" class="card submit-form" novalidate>
          <!-- Row 1 -->
          <div class="form-row">
            <div class="form-group">
              <label for="vendorName">
                <span class="material-icons-round">store</span>
                Vendor Name
              </label>
              <input
                type="text" id="vendorName"
                placeholder="e.g. Sharma Vada Pav"
                autocomplete="off" maxlength="60"
              />
              <span class="char-counter" id="vendorNameCounter">0 / 60</span>
            </div>

            <div class="form-group">
              <label for="vendorType">
                <span class="material-icons-round">category</span>
                Vendor Type
              </label>
              <select id="vendorType">
                <option>Street Cart</option>
                <option>Food Truck</option>
                <option>Tea Stall</option>
                <option>Juice Center</option>
                <option>Small Restaurant</option>
              </select>
            </div>
          </div>

          <!-- Issues -->
          <div class="form-group">
            <label>
              <span class="material-icons-round">bug_report</span>
              Hygiene Issues Observed
            </label>
            <div class="checkbox-grid">
              {["Dirty utensils", "Spoiled food", "Insects", "No gloves", "Open drain nearby", "No hand washing"].map((issue) => (
                <label class="check-label">
                  <input type="checkbox" value={issue} />
                  <span class="check-box"></span>
                  {issue}
                </label>
              ))}
            </div>
          </div>

          <!-- Severity -->
          <div class="form-group">
            <label>
              <span class="material-icons-round">priority_high</span>
              Severity Level
            </label>
            <div class="severity-btns" id="severityBtns">
              <button type="button" class="sev-btn" data-val="Low">Low</button>
              <button type="button" class="sev-btn" data-val="Medium">Medium</button>
              <button type="button" class="sev-btn" data-val="High">High</button>
              <button type="button" class="sev-btn active" data-val="Critical">Critical</button>
            </div>
            <input type="hidden" id="severity" value="Critical" />
          </div>

          <!-- Image with crop -->
          <div class="form-group">
            <label for="image">
              <span class="material-icons-round">photo_camera</span>
              Upload Evidence Image
            </label>
            <div class="file-drop" id="fileDrop">
              <span class="material-icons-round drop-icon">cloud_upload</span>
              <p>Drag & drop or <span class="file-link">browse files</span></p>
              <p class="file-hint">JPG, PNG up to 10MB · Will be cropped to 1:1</p>
              <input type="file" id="image" accept="image/*" />
            </div>
            <div id="imagePreviewWrap" class="image-preview-wrap" style="display:none">
              <img id="imagePreview" class="img-fixed img-cropped-preview" src="" alt="Preview" />
              <button type="button" id="removeImage" class="remove-img">
                <span class="material-icons-round">close</span>
              </button>
              <button type="button" id="recropImage" class="recrop-btn">
                <span class="material-icons-round">crop</span>
                Re-crop
              </button>
            </div>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="description">
              <span class="material-icons-round">description</span>
              Detailed Description
            </label>
            <textarea
              id="description"
              placeholder="Describe what you observed. Be specific about date, time, and conditions…"
              maxlength="500"
            ></textarea>
            <span class="char-counter" id="descCounter">0 / 500</span>
          </div>

          <!-- Location -->
          <div class="form-group">
            <label>
              <span class="material-icons-round">location_on</span>
              Location
            </label>
            <div class="location-btns">
              <button type="button" class="secondary-btn" id="locationBtn">
                <span class="material-icons-round">my_location</span>
                Use Current Location
              </button>
            </div>
            <div class="location-status" id="locationStatus">
              <span class="material-icons-round">location_off</span>
              <span id="locationText">No location selected</span>
            </div>
          </div>

          <!-- Rate limit indicator -->
          <div class="rate-limit-bar" id="rateLimitBar" style="display:none">
            <span class="material-icons-round">timer</span>
            <span id="rateLimitText">Please wait before submitting again</span>
          </div>

          <button type="submit" class="primary-btn submit-btn" id="submitBtn">
            <span class="material-icons-round">send</span>
            Submit Complaint
          </button>

          <p id="statusMessage" class="status-msg"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- Crop Modal -->
  <div class="crop-modal-overlay" id="cropModalOverlay">
    <div class="crop-modal">
      <div class="crop-modal-header">
        <h2><span class="material-icons-round">crop</span>Crop Your Image</h2>
        <p class="crop-hint">Drag to reposition · Scroll to zoom</p>
      </div>
      <div class="crop-canvas-wrap">
        <canvas id="cropCanvas"></canvas>
        <div class="crop-overlay">
          <div class="crop-frame" id="cropFrame"></div>
        </div>
      </div>
      <div class="crop-controls">
        <input type="range" id="cropZoom" min="1" max="3" step="0.01" value="1" class="zoom-slider" />
        <div class="crop-actions">
          <button type="button" class="secondary-btn" id="cancelCrop">Cancel</button>
          <button type="button" class="primary-btn" id="confirmCrop">
            <span class="material-icons-round">check</span>
            Apply Crop
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast" aria-live="polite"></div>

  <script>
    // ── Profanity filter ─────────────────────────────────────────────────────
    // Lightweight list — extend as needed
    const PROFANITY_LIST = [
      "fuck", "shit", "bitch", "asshole", "bastard", "damn", "crap",
      "piss", "dick", "cock", "pussy", "cunt", "motherfucker", "fucker",
      "bullshit", "jackass", "moron", "idiot", "retard", "slut", "whore",
    ];

    function containsProfanity(text: string): boolean {
      const lower = text.toLowerCase().replace(/[^a-z0-9\s]/g, "");
      return PROFANITY_LIST.some(word => {
        const regex = new RegExp(`\\b${word}\\b`, "i");
        return regex.test(lower);
      });
    }

    function sanitizeText(text: string): string {
      let out = text;
      PROFANITY_LIST.forEach(word => {
        const regex = new RegExp(`\\b${word}\\b`, "gi");
        out = out.replace(regex, "*".repeat(word.length));
      });
      return out;
    }

    // ── Rate limiting ────────────────────────────────────────────────────────
    const RATE_LIMIT_MS = 60_000; // 1 minute between submissions
    const RATE_LIMIT_KEY = "lastSubmitTime";

    function getRemainingCooldown(): number {
      const last = parseInt(localStorage.getItem(RATE_LIMIT_KEY) || "0", 10);
      const elapsed = Date.now() - last;
      return Math.max(0, RATE_LIMIT_MS - elapsed);
    }

    function setSubmitTime() {
      localStorage.setItem(RATE_LIMIT_KEY, String(Date.now()));
    }

    let cooldownTimer: ReturnType<typeof setInterval> | null = null;

    function startCooldownUI(remaining: number) {
      const bar = document.getElementById("rateLimitBar")!;
      const text = document.getElementById("rateLimitText")!;
      const btn = document.getElementById("submitBtn") as HTMLButtonElement;

      bar.style.display = "flex";
      btn.disabled = true;

      const update = () => {
        const left = getRemainingCooldown();
        if (left <= 0) {
          bar.style.display = "none";
          btn.disabled = false;
          if (cooldownTimer) clearInterval(cooldownTimer);
          cooldownTimer = null;
          return;
        }
        const secs = Math.ceil(left / 1000);
        text.textContent = `You can submit again in ${secs}s`;
      };

      update();
      cooldownTimer = setInterval(update, 500);
    }

    // Check cooldown on load
    window.addEventListener("DOMContentLoaded", () => {
      const remaining = getRemainingCooldown();
      if (remaining > 0) startCooldownUI(remaining);
    });

    // ── Toast ────────────────────────────────────────────────────────────────
    function showToast(msg: string, type: "success" | "error" | "info" = "info") {
      const t = document.getElementById("toast")!;
      const icons: Record<string, string> = { success: "check_circle", error: "error", info: "info" };
      t.className = `toast toast-${type} show`;
      t.innerHTML = `<span class="material-icons-round">${icons[type]}</span><span>${msg}</span>`;
      setTimeout(() => t.classList.remove("show"), 4000);
    }

    // ── Timestamp ────────────────────────────────────────────────────────────
    function formatSubmitTime(): string {
      return new Date().toLocaleString("en-IN", {
        day: "numeric", month: "short", year: "numeric",
        hour: "2-digit", minute: "2-digit"
      });
    }

    // ── Cropper state ────────────────────────────────────────────────────────
    const CROP_SIZE = 400;
    let cropImg = new Image();
    let cropScale = 1;
    let cropOffsetX = 0, cropOffsetY = 0;
    let cropDragging = false;
    let cropDragStartX = 0, cropDragStartY = 0;
    let cropDragOriginX = 0, cropDragOriginY = 0;
    let croppedBlob: Blob | null = null;
    let originalFile: File | null = null;
    let latitude: number | null = null;
    let longitude: number | null = null;

    const cropOverlay = document.getElementById("cropModalOverlay")!;
    const cropCanvas = document.getElementById("cropCanvas") as HTMLCanvasElement;
    const ctx = cropCanvas.getContext("2d")!;
    const zoomSlider = document.getElementById("cropZoom") as HTMLInputElement;
    const imageInput = document.getElementById("image") as HTMLInputElement;
    const locationBtn = document.getElementById("locationBtn")!;
    const locationText = document.getElementById("locationText")!;
    const locationStatus = document.getElementById("locationStatus")!;

    cropCanvas.width = CROP_SIZE;
    cropCanvas.height = CROP_SIZE;

    function drawCrop() {
      ctx.clearRect(0, 0, CROP_SIZE, CROP_SIZE);
      ctx.drawImage(cropImg, cropOffsetX, cropOffsetY, cropImg.naturalWidth * cropScale, cropImg.naturalHeight * cropScale);
    }

    function clampOffsets() {
      const w = cropImg.naturalWidth * cropScale;
      const h = cropImg.naturalHeight * cropScale;
      cropOffsetX = Math.min(0, Math.max(CROP_SIZE - w, cropOffsetX));
      cropOffsetY = Math.min(0, Math.max(CROP_SIZE - h, cropOffsetY));
    }

    function openCropper(file: File) {
      originalFile = file;
      const url = URL.createObjectURL(file);
      cropImg = new Image();
      cropImg.onload = () => {
        const ratio = Math.max(CROP_SIZE / cropImg.naturalWidth, CROP_SIZE / cropImg.naturalHeight);
        cropScale = ratio;
        cropOffsetX = (CROP_SIZE - cropImg.naturalWidth * cropScale) / 2;
        cropOffsetY = (CROP_SIZE - cropImg.naturalHeight * cropScale) / 2;
        zoomSlider.min = String(ratio);
        zoomSlider.max = String(ratio * 3);
        zoomSlider.step = String(ratio * 0.01);
        zoomSlider.value = "1";
        drawCrop();
        cropOverlay.classList.add("active");
        document.body.style.overflow = "hidden";
        URL.revokeObjectURL(url);
      };
      cropImg.src = url;
    }

    cropCanvas.addEventListener("mousedown", e => {
      cropDragging = true;
      cropDragStartX = e.clientX; cropDragStartY = e.clientY;
      cropDragOriginX = cropOffsetX; cropDragOriginY = cropOffsetY;
      cropCanvas.style.cursor = "grabbing";
    });
    window.addEventListener("mousemove", e => {
      if (!cropDragging) return;
      cropOffsetX = cropDragOriginX + (e.clientX - cropDragStartX);
      cropOffsetY = cropDragOriginY + (e.clientY - cropDragStartY);
      clampOffsets(); drawCrop();
    });
    window.addEventListener("mouseup", () => { cropDragging = false; cropCanvas.style.cursor = "grab"; });
    cropCanvas.addEventListener("touchstart", e => {
      const t = e.touches[0];
      cropDragging = true;
      cropDragStartX = t.clientX; cropDragStartY = t.clientY;
      cropDragOriginX = cropOffsetX; cropDragOriginY = cropOffsetY;
    }, { passive: true });
    window.addEventListener("touchmove", e => {
      if (!cropDragging) return;
      const t = e.touches[0];
      cropOffsetX = cropDragOriginX + (t.clientX - cropDragStartX);
      cropOffsetY = cropDragOriginY + (t.clientY - cropDragStartY);
      clampOffsets(); drawCrop();
    }, { passive: true });
    window.addEventListener("touchend", () => { cropDragging = false; });

    zoomSlider.addEventListener("input", () => {
      const newScale = parseFloat(zoomSlider.value);
      const cx = CROP_SIZE / 2, cy = CROP_SIZE / 2;
      cropOffsetX = cx - (cx - cropOffsetX) * (newScale / cropScale);
      cropOffsetY = cy - (cy - cropOffsetY) * (newScale / cropScale);
      cropScale = newScale;
      clampOffsets(); drawCrop();
    });

    cropCanvas.addEventListener("wheel", e => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? -0.05 : 0.05;
      const newScale = Math.max(parseFloat(zoomSlider.min), Math.min(parseFloat(zoomSlider.max), cropScale + delta * cropScale));
      const cx = CROP_SIZE / 2, cy = CROP_SIZE / 2;
      cropOffsetX = cx - (cx - cropOffsetX) * (newScale / cropScale);
      cropOffsetY = cy - (cy - cropOffsetY) * (newScale / cropScale);
      cropScale = newScale;
      zoomSlider.value = String(cropScale);
      clampOffsets(); drawCrop();
    }, { passive: false });

    document.getElementById("confirmCrop")!.addEventListener("click", () => {
      const out = document.createElement("canvas");
      out.width = CROP_SIZE; out.height = CROP_SIZE;
      out.getContext("2d")!.drawImage(cropCanvas, 0, 0);
      out.toBlob(blob => {
        if (!blob) return;
        croppedBlob = blob;
        const url = URL.createObjectURL(blob);
        (document.getElementById("imagePreview") as HTMLImageElement).src = url;
        document.getElementById("imagePreviewWrap")!.style.display = "flex";
        document.getElementById("fileDrop")!.style.display = "none";
        cropOverlay.classList.remove("active");
        document.body.style.overflow = "";
      }, "image/jpeg", 0.92);
    });

    document.getElementById("cancelCrop")!.addEventListener("click", () => {
      cropOverlay.classList.remove("active");
      document.body.style.overflow = "";
      imageInput.value = "";
    });

    document.getElementById("recropImage")!.addEventListener("click", () => {
      if (originalFile) openCropper(originalFile);
    });

    document.querySelectorAll(".sev-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".sev-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        (document.getElementById("severity") as HTMLInputElement).value = (btn as HTMLElement).dataset.val!;
      });
    });

    imageInput.addEventListener("change", () => {
      const file = imageInput.files?.[0];
      if (!file) return;
      if (file.size > 10 * 1024 * 1024) {
        showToast("Image must be under 10MB", "error");
        return;
      }
      openCropper(file);
    });

    document.getElementById("removeImage")!.addEventListener("click", () => {
      imageInput.value = "";
      croppedBlob = null;
      document.getElementById("imagePreviewWrap")!.style.display = "none";
      document.getElementById("fileDrop")!.style.display = "flex";
    });

    const fileDrop = document.getElementById("fileDrop")!;
    fileDrop.addEventListener("click", () => imageInput.click());
    fileDrop.addEventListener("dragover", e => { e.preventDefault(); fileDrop.classList.add("drag-over"); });
    fileDrop.addEventListener("dragleave", () => fileDrop.classList.remove("drag-over"));
    fileDrop.addEventListener("drop", e => {
      e.preventDefault();
      fileDrop.classList.remove("drag-over");
      const file = e.dataTransfer?.files?.[0];
      if (file) openCropper(file);
    });

    // Char counters
    function initCounter(inputId: string, counterId: string, max: number) {
      const el = document.getElementById(inputId) as HTMLInputElement | HTMLTextAreaElement;
      const counter = document.getElementById(counterId)!;
      const update = () => {
        const len = el.value.length;
        counter.textContent = `${len} / ${max}`;
        counter.classList.toggle("counter-warn", len >= max * 0.85);
        counter.classList.toggle("counter-full", len >= max);
      };
      el.addEventListener("input", update);
      update();
    }
    initCounter("vendorName", "vendorNameCounter", 60);
    initCounter("description", "descCounter", 500);

    // Location
    locationBtn.addEventListener("click", () => {
      locationBtn.innerHTML = '<span class="material-icons-round">hourglass_empty</span>Locating…';
      navigator.geolocation.getCurrentPosition(
        pos => {
          latitude = pos.coords.latitude;
          longitude = pos.coords.longitude;
          locationText.textContent = `${latitude.toFixed(5)}, ${longitude.toFixed(5)}`;
          locationStatus.classList.add("has-location");
          locationStatus.querySelector(".material-icons-round")!.textContent = "location_on";
          locationBtn.innerHTML = '<span class="material-icons-round">my_location</span>Use Current Location';
          showToast("Location captured", "success");
        },
        () => {
          locationBtn.innerHTML = '<span class="material-icons-round">my_location</span>Use Current Location';
          showToast("Could not access location", "error");
        }
      );
    });

    // Upload stub
    import { supabase } from "../utils/supabase.js";

async function uploadImage(): Promise<string | null> {
  if (!croppedBlob) return null;

  const fileName = `complaint-${Date.now()}.jpg`;

  const { data, error } = await supabase.storage
    .from("complaint-images")
    .upload(fileName, croppedBlob, {
      contentType: "image/jpeg",
      upsert: false,
    });

  if (error) {
    console.error("Upload error:", error.message);
    return null;
  }

  const { data: publicUrl } = supabase.storage
    .from("complaint-images")
    .getPublicUrl(fileName);

  return publicUrl.publicUrl;
}

    // ── Submit ───────────────────────────────────────────────────────────────
    document.getElementById("feedbackForm")!.addEventListener("submit", async e => {
      e.preventDefault();

      // Rate limit check
      const remaining = getRemainingCooldown();
      if (remaining > 0) {
        showToast(`Please wait ${Math.ceil(remaining / 1000)}s before submitting again`, "error");
        startCooldownUI(remaining);
        return;
      }

      const vendorName = (document.getElementById("vendorName") as HTMLInputElement).value.trim();
      const vendorType = (document.getElementById("vendorType") as HTMLSelectElement).value;
      const severity = (document.getElementById("severity") as HTMLInputElement).value;
      const description = (document.getElementById("description") as HTMLTextAreaElement).value.trim();
      const checkedIssues = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
      ).map(c => c.value);

      // Validation
      if (!vendorName) {
        showToast("Vendor name is required", "error");
        return;
      }
      if (description.length < 10) {
        showToast("Description must be at least 10 characters", "error");
        return;
      }
      if (checkedIssues.length === 0) {
        showToast("Please select at least one hygiene issue", "error");
        return;
      }

      // Profanity check
      const fieldsToCheck = [vendorName, description];
      for (const field of fieldsToCheck) {
        if (containsProfanity(field)) {
          showToast("Please remove inappropriate language before submitting", "error");
          return;
        }
      }

      const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
      try {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-icons-round">hourglass_empty</span>Submitting…';

        const imageUrl = await uploadImage();

        const res = await fetch("https://worker-api.yatin-a-anchan.workers.dev/api/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            vendor_name: vendorName,
            vendor_type: vendorType,
            issue_types: checkedIssues,
            severity,
            description,
            image_url: imageUrl,
            latitude,
            longitude,
          }),
        });

        if (!res.ok) throw new Error(`Server error: ${res.status}`);

        // Set rate limit
        setSubmitTime();
        startCooldownUI(RATE_LIMIT_MS);

        showToast(`Complaint submitted at ${formatSubmitTime()} ✓`, "success");

        // Reset form
        (document.getElementById("feedbackForm") as HTMLFormElement).reset();
        croppedBlob = null; originalFile = null; latitude = null; longitude = null;
        locationText.textContent = "No location selected";
        locationStatus.classList.remove("has-location");
        locationStatus.querySelector(".material-icons-round")!.textContent = "location_off";
        document.getElementById("imagePreviewWrap")!.style.display = "none";
        document.getElementById("fileDrop")!.style.display = "flex";
        document.querySelectorAll(".sev-btn").forEach((b, i) => b.classList.toggle("active", i === 3));
        (document.getElementById("severity") as HTMLInputElement).value = "Critical";
        document.getElementById("vendorNameCounter")!.textContent = "0 / 60";
        document.getElementById("descCounter")!.textContent = "0 / 500";

        // Show status message
        const msg = document.getElementById("statusMessage")!;
        msg.textContent = "Complaint submitted successfully. Thank you for keeping your community safe!";
        msg.className = "status-msg success";
        msg.scrollIntoView({ behavior: "smooth", block: "nearest" });

      } catch {
        showToast("Submission failed. Please try again.", "error");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="material-icons-round">send</span>Submit Complaint';
      }
    });
  </script>

  <style>
    .submit-wrap { max-width: 780px; margin: auto; }

    .submit-header { display:flex; align-items:center; gap:1.25rem; margin-bottom:2.5rem; }
    .submit-icon { width:60px; height:60px; border-radius:var(--radius); background:var(--primary-glow); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .submit-icon .material-icons-round { color:var(--primary); font-size:1.8rem !important; }
    .submit-header h1 { font-size:2rem; margin-bottom:0.25rem; }
    .subtitle { color:var(--muted); font-size:0.95rem; }

    .submit-form { display:flex; flex-direction:column; gap:1.75rem; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    @media (max-width:600px) { .form-row { grid-template-columns:1fr; } }

    .form-group { display:flex; flex-direction:column; gap:0.5rem; }
    .form-group label { display:flex; align-items:center; gap:0.4rem; font-weight:600; font-size:0.9rem; }
    .form-group label .material-icons-round { font-size:1rem !important; color:var(--primary); }

    .char-counter { align-self:flex-end; font-size:0.75rem; color:var(--muted); transition:color 0.2s; user-select:none; }
    .char-counter.counter-warn { color: var(--medium, #ca8a04); }
    .char-counter.counter-full { color: var(--high, #dc2626); font-weight:700; }

    .checkbox-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:0.6rem; }
    .check-label {
      display:flex; align-items:center; gap:0.6rem; cursor:pointer;
      padding:0.6rem 0.9rem; border-radius:var(--radius-sm);
      border:1px solid var(--border2); background:var(--bg2);
      font-size:0.9rem; transition:all 0.2s;
    }
    .check-label:hover { border-color:var(--primary); background:var(--primary-glow); }
    .check-label input[type="checkbox"] { display:none; }
    .check-box {
      width:18px; height:18px; border-radius:5px; flex-shrink:0;
      border:2px solid var(--border2); background:var(--bg);
      transition:all 0.2s; position:relative;
    }
    .check-label input:checked ~ .check-box { background:var(--primary); border-color:var(--primary); }
    .check-label input:checked ~ .check-box::after {
      content:''; position:absolute; left:4px; top:1px;
      width:6px; height:10px; border:2px solid white;
      border-top:none; border-left:none; transform:rotate(45deg);
    }

    .severity-btns { display:flex; gap:0.5rem; flex-wrap:wrap; }
    .sev-btn {
