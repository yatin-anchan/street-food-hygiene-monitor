---
const {
    name,
    message,
    created_at
} = Astro.props;

const formattedDate =
    new Date(created_at)
        .toLocaleString();
---

<div class="card feedback-card">
    <div class="card-top">
        <h3>
            {name || "Anonymous"}
        </h3>
        <span>{formattedDate}</span>
    </div>

    <p class="message">
        {message}
    </p>
</div>

<style>
    .feedback-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: 0.2s ease;
    }

    .feedback-card:hover {
        transform: translateY(-4px);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .card-top h3 {
        font-size: 1.1rem;
    }

    .card-top span {
        color: var(--muted);
        font-size: 0.9rem;
    }

    .message {
        color: #e2e8f0;
        line-height: 1.7;
    }

</style>