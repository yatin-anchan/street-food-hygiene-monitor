---
const { name, message, created_at } = Astro.props;
const formattedDate = new Date(created_at).toLocaleString('en-IN', {
  dateStyle: 'medium', timeStyle: 'short'
});
const initials = (name || 'A').slice(0, 2).toUpperCase();
---
<div class="card feedback-card">
  <div class="card-top">
    <div class="avatar" aria-hidden="true">{initials}</div>
    <div class="meta">
      <h3>{name || "Anonymous"}</h3>
      <span class="time">
        <span class="material-icons-round">schedule</span>
        {formattedDate}
      </span>
    </div>
  </div>
  <p class="message">{message}</p>
</div>

<style>
  .feedback-card {
    display: flex; flex-direction: column; gap: 1rem;
    transition: all 0.25s ease;
  }
  .feedback-card:hover {
    transform: translateY(-4px);
    border-color: var(--border2);
    box-shadow: var(--shadow);
  }
  .card-top { display: flex; align-items: center; gap: 0.85rem; }
  .avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), #a78bfa);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700; color: white;
    flex-shrink: 0; letter-spacing: 0.05em;
  }
  .meta h3 { font-size: 0.95rem; font-weight: 600; }
  .time {
    display: flex; align-items: center; gap: 0.25rem;
    color: var(--muted); font-size: 0.8rem;
  }
  .time .material-icons-round { font-size: 0.85rem !important; }
  .message { color: var(--text2); line-height: 1.75; font-size: 0.95rem; }
</style>